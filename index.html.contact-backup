        content="Kontraktor Amanah Bandung — renovasi, pembangunan rumah, bangunan komersial, desain arsitektur dan interior.">
    <title>Kontraktor Amanah — Bangun & Renovasi</title>
    <style>
        :root {
            --bg: #080808;
            --surface: #111;
            --surface2: #181818;
            --text: #f7f7f5;
            --muted: #a8a8a3;
            --accent: #ff7e00;
            --line: #292929;
            --nav: rgba(8, 8, 8, .76);
            --heroShade: rgba(0, 0, 0, .92);
            --heroMid: rgba(0, 0, 0, .62);
            --heroEnd: rgba(0, 0, 0, .25);
            --navText: #d2d2ce;
            --lead: #c4c4bf;
            --copy: #8e8e88;
            --max: 1180px
        }

        

        * {
            box-sizing: border-box
        }

        html {
            scroll-behavior: smooth
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font: 16px/1.65 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
        }

        a {
            color: inherit;
            text-decoration: none
        }

        img {
            display: block;
            width: 100%;
            object-fit: cover
        }

        .wrap {
            width: min(calc(100% - 40px), var(--max));
            margin: auto
        }

        .nav {
            --line: #292929;
            --surface: #111;
            --text: #f7f7f5;
            position: fixed;
            z-index: 20;
            inset: 0 0 auto;
            background: var(--nav);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--line)
        }

        .navin {
            height: 78px;
            display: flex;
            align-items: center;
            justify-content: space-between
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 20px
        }

        .brand img {
            width: 42px;
            height: 42px
        }

        .links {
            display: flex;
            align-items: center;
            gap: 26px;
            color: var(--navText);
            font-size: 14px
        }

        

        

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 13px 20px;
            background: var(--accent);
            color: #111;
            font-weight: 800;
            border-radius: 7px
        }

        .hero {
            min-height: 100svh;
            position: relative;
            display: flex;
            align-items: flex-end;
            overflow: hidden
        }

        .hero:before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, var(--heroShade) 0%, var(--heroMid) 48%, var(--heroEnd)), linear-gradient(0deg, var(--bg) 0%, transparent 32%);
            z-index: 1
        }

        .hero-bg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover
        }

        .hero-content {
            position: relative;
            z-index: 2;
            padding: 160px 0 110px;
            max-width: 850px
        }

        .eyebrow {
            color: var(--accent);
            font-size: 13px;
            font-weight: 800;
            letter-spacing: .15em;
            text-transform: uppercase
        }

        .hero h1 {
            color: #f7f7f5;
            font-size: clamp(48px, 7vw, 88px);
            line-height: .98;
            letter-spacing: -.055em;
            margin: 18px 0 24px
        }

        .hero p {
            font-size: clamp(18px, 2vw, 23px);
            color: #f0f0ec;
            max-width: 650px;
            margin: 0 0 32px
        }

        .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap
        }

        .ghost {
            background: transparent;
            color: white;
            border: 1px solid #555
        }

        .section {
            padding: 110px 0
        }

        .dark-section {
            background: #111111;
            color: #f7f7f5
        }

        .dark-section .head p {
            color: #d2d2ce
        }

        .dark-section .service {
            background: #111;
            color: #f7f7f5;
            border-color: #292929
        }

        .dark-section .service:hover {
            background: #181818
        }

        .dark-section .service p {
            color: #b8b8b2
        }

        .dark-section .services {
            border-color: #292929;
            background: #292929
        }

        .intro {
            display: grid;
            grid-template-columns: .8fr 1.2fr;
            gap: 80px;
            align-items: start
        }

        .team-photo {
            margin-top: 36px;
            overflow: hidden;
            border-radius: 8px;
            aspect-ratio: 16/9;
            background: var(--surface)
        }

        .team-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover
        }

        .intro h2,
        .head h2,
        .cta h2 {
            font-size: clamp(36px, 5vw, 62px);
            line-height: 1.02;
            letter-spacing: -.04em;
            margin: 12px 0 0
        }

        .lead {
            font-size: 20px;
            color: var(--lead);
            margin: 0 0 40px
        }

        .trust {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1px;
            background: var(--line);
            border: 1px solid var(--line)
        }

        .trust article {
            background: var(--surface);
            padding: 28px
        }

        .num {
            color: var(--accent);
            font-weight: 900;
            font-size: 13px
        }

        .trust h3 {
            margin: 8px 0 5px;
            font-size: 20px
        }

        .trust p {
            margin: 0;
            color: var(--muted);
            font-size: 14px
        }

        .head {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 30px;
            margin-bottom: 45px
        }

        .head p {
            color: var(--muted);
            max-width: 460px;
            margin: 0
        }

        .services {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            border-top: 1px solid var(--line);
            border-left: 1px solid var(--line)
        }

        .service {
            padding: 34px;
            min-height: 260px;
            border-right: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            background: var(--surface);
            transition: .25s
        }

        .service:hover {
            background: var(--surface2);
            transform: translateY(-3px)
        }

        .service b {
            color: var(--accent);
            font-size: 12px
        }

        .service h3 {
            font-size: 25px;
            line-height: 1.15;
            margin: 45px 0 12px
        }

        .service p {
            color: var(--muted);
            margin: 0
        }

        .projects {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 16px
        }

        .project {
            position: relative;
            overflow: hidden;
            background: #151515;
            min-height: 0;
            aspect-ratio: 4 / 3
        }

        .project:nth-child(1),
        .project:nth-child(6) {
            grid-column: span 7
        }

        .project:nth-child(2),
        .project:nth-child(7) {
            grid-column: span 5
        }

        .project:nth-child(3),
        .project:nth-child(8) {
            grid-column: span 5
        }

        .project:nth-child(4),
        .project:nth-child(5) {
            grid-column: span 7
        }

        .project img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: transform .5s ease
        }

        /* Foto portrait: tampilkan area lebih luas */
        .project:nth-child(2) img,
        .project:nth-child(3) img,
        .project:nth-child(5) img,
        .project:nth-child(7) img {
            object-fit: contain;
            background: #111
        }

        .project:hover img {
            transform: scale(1.02)
        }

        .project:after {
            content: "";
            position: absolute;
            inset: 45% 0 0;
            background: linear-gradient(
                transparent,
                rgba(0, 0, 0, .88)
            );
            pointer-events: none
        }

        .project-info {
            position: absolute;
            z-index: 2;
            left: 28px;
            right: 28px;
            bottom: 25px
        }

        .project-info span {
            color: #ddd;
            font-size: 13px
        }

        .project-info h3 {
            font-size: 25px;
            margin: 4px 0
        }

        .cta {
            background: #111111;
            color: #f7f7f5;
            padding: 96px 0;
            border-top: 1px solid #292929;
            border-bottom: 1px solid #292929
        }

        .cta-grid {
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: end;
            gap: 40px
        }

        .cta .eyebrow {
            color: var(--accent)
        }

        .cta p {
            max-width: 650px;
            font-size: 18px;
            color: #b8b8b2
        }

        .cta .btn {
            background: var(--accent);
            color: #111
        }

        .footer {
            --text: #f7f7f5;
            --muted: #a8a8a3;
            --line: #292929;
            --copy: #8e8e88;
            padding: 55px 0 35px;
            background: #050505;
            color: #f7f7f5
        }

        .foot {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr;
            gap: 50px
        }

        .foot p,
        .foot a {
            color: var(--muted)
        }

        .foot h4 {
            margin-top: 0
        }

        .foot a {
            display: block;
            margin: 8px 0
        }

        .copy {
            border-top: 1px solid var(--line);
            margin-top: 45px;
            padding-top: 25px;
            color: var(--copy);
            font-size: 13px
        }

        .socials {
            display: flex;
            gap: 10px;
            margin-top: 18px
        }

        .socials a {
            display: inline-flex;
            width: 40px;
            height: 40px;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--line);
            border-radius: 50%;
            color: var(--text);
            margin: 0;
            transition: .2s
        }

        .socials a:hover {
            border-color: var(--accent);
            color: var(--accent);
            transform: translateY(-2px)
        }

        .socials svg {
            width: 18px;
            height: 18px;
            fill: currentColor
        }

        @media(max-width:800px) {
            .links a:not(.btn) {
                display: none
            }

            .wrap {
                width: min(calc(100% - 28px), var(--max))
            }

            .hero-content {
                padding-bottom: 70px
            }

            .intro,
            .cta-grid,
            .foot {
                grid-template-columns: 1fr;
                gap: 35px
            }

            .services {
                grid-template-columns: 1fr
            }

            .projects {
                grid-template-columns: 1fr;
                grid-auto-rows: 340px
            }

            .project,
            .project:nth-child(1),
            .project:nth-child(2),
            .project:nth-child(3),
            .project:nth-child(4),
            .project:nth-child(5) {
                grid-column: auto
            }

            .section {
                padding: 78px 0
            }

            .head {
                display: block
            }

            .head p {
                margin-top: 20px
            }

            .trust {
                grid-template-columns: 1fr
            }


            .projects {
                grid-template-columns: 1fr;
                gap: 14px
            }

            .project,
            .project:nth-child(1),
            .project:nth-child(2),
            .project:nth-child(3),
            .project:nth-child(4),
            .project:nth-child(5),
            .project:nth-child(6),
            .project:nth-child(7),
            .project:nth-child(8) {
                grid-column: auto;
                aspect-ratio: 4 / 3
            }

            .hero h1 {
                color: #f7f7f5;
                font-size: 50px
            }
        }
    </style>
</head>

